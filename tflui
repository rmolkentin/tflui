#!/usr/bin/env python3
"""tflui - a thin wrapper around testflinger-cli.

`tflui list` (alias: no args) lists your active testflinger reservations in
an `lxc list`-style table, showing the agent, device IP, and how much lease
time is left before the reservation expires.

`tflui ssh [target]` ssh's into a reserved device, matching `target` against
a job id (or prefix) or agent name. If omitted and only one reservation is
active, that one is used.
"""
import argparse
import configparser
import datetime
import getpass
import re
import json
import os
import pathlib
import re
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor

TFL = "testflinger-cli"
DEFAULT_LEASE = os.environ.get("TFLUI_LEASE", "14d")
DEFAULT_QUEUE = os.environ.get("TFLUI_QUEUE", "support-team")
DEFAULT_DISTRO = os.environ.get("TFLUI_DISTRO", "noble")
DEFAULT_TIMEOUT = int(os.environ.get("TFLUI_TIMEOUT", "1206900"))
DEFAULT_KEY = os.environ.get("TFLUI_KEY")
CONFIG_DIR = pathlib.Path(
    os.environ.get("XDG_CONFIG_HOME", "~/.config")
).expanduser() / "tflui"
CREDENTIALS_FILE = CONFIG_DIR / "credentials.conf"
HISTORY_FILE = pathlib.Path(
    "~/snap/testflinger-cli/current/.config/testflinger-cli-history.json"
).expanduser()
AUTH_FILE = pathlib.Path(
    "~/snap/testflinger-cli/current/.config/testflinger-cli-auth.conf"
).expanduser()
ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")
JOB_ID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
DURATION_RE = re.compile(r"(\d+)([smhdw]?)")


def run_tfl(*args):
    env = os.environ.copy()
    if (
        "TESTFLINGER_CLIENT_ID" not in env
        and "TESTFLINGER_SECRET_KEY" not in env
    ):
        credentials = load_credentials()
        if credentials:
            env["TESTFLINGER_CLIENT_ID"] = credentials[0]
            env["TESTFLINGER_SECRET_KEY"] = credentials[1]

    result = subprocess.run(
        [TFL, *args], capture_output=True, text=True, check=False, env=env
    )
    return result.returncode, result.stdout, result.stderr


def load_credentials():
    config = configparser.ConfigParser(interpolation=None)
    try:
        with CREDENTIALS_FILE.open() as credential_file:
            config.read_file(credential_file)
    except FileNotFoundError:
        return None
    except (OSError, configparser.Error) as exc:
        print(f"Unable to read saved credentials: {exc}", file=sys.stderr)
        sys.exit(1)

    client_id = config.get("AUTH", "client_id", fallback="")
    secret_key = config.get("AUTH", "secret_key", fallback="")
    if client_id and secret_key:
        return client_id, secret_key
    return None


def store_credentials(client_id, secret_key):
    config = configparser.ConfigParser(interpolation=None)
    config["AUTH"] = {"client_id": client_id, "secret_key": secret_key}
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(CONFIG_DIR, 0o700)
        with CREDENTIALS_FILE.open("w") as credential_file:
            config.write(credential_file)
        os.chmod(CREDENTIALS_FILE, 0o600)
    except OSError as exc:
        print(f"Unable to securely save credentials: {exc}", file=sys.stderr)
        sys.exit(1)


def get_job_ids():
    """Return job ids known to the local testflinger-cli history.

    Reads the history file directly to avoid a slow network round trip
    through `testflinger-cli jobs`, falling back to the CLI if unavailable.
    """
    try:
        history = json.loads(HISTORY_FILE.read_text())
        return list(history.keys())
    except (OSError, json.JSONDecodeError):
        pass

    rc, out, err = run_tfl("jobs")
    if rc != 0:
        print(err.strip() or "failed to list testflinger jobs", file=sys.stderr)
        sys.exit(1)

    job_ids = []
    for line in out.splitlines():
        job_id = line.split()[0] if line.strip() else ""
        if len(job_id) == 36 and job_id.count("-") == 4:
            job_ids.append(job_id)
    return job_ids


def get_job_results(job_id):
    rc, out, _ = run_tfl("results", job_id)
    if rc != 0:
        return {}
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        return {}


def parse_expiry(reserve_output):
    """Extract the reservation expiry timestamp from reserve_output text."""
    marker = "Reservation expires at: ["
    idx = reserve_output.find(marker)
    if idx == -1:
        return None
    start = idx + len(marker)
    end = reserve_output.find("]", start)
    if end == -1:
        return None
    try:
        return datetime.datetime.fromisoformat(reserve_output[start:end])
    except ValueError:
        return None


def format_timedelta(delta):
    total_seconds = int(delta.total_seconds())
    if total_seconds <= 0:
        return "expired"
    days, remainder = divmod(total_seconds, 86400)
    hours, remainder = divmod(remainder, 3600)
    minutes, _ = divmod(remainder, 60)
    parts = []
    if days:
        parts.append(f"{days}d")
    if hours or days:
        parts.append(f"{hours}h")
    parts.append(f"{minutes}m")
    return "".join(parts)


def parse_duration(value):
    value = str(value).strip().lower()
    if not value:
        raise ValueError("empty duration")

    multipliers = {"": 1, "s": 1, "m": 60, "h": 3600, "d": 86400, "w": 604800}
    total = 0
    position = 0
    for match in DURATION_RE.finditer(value):
        if match.start() != position:
            raise ValueError(value)
        amount, unit = match.groups()
        total += int(amount) * multipliers[unit]
        position = match.end()

    if position != len(value) or total <= 0:
        raise ValueError(value)
    return total


def format_duration(seconds):
    return format_timedelta(datetime.timedelta(seconds=seconds))


def print_table(rows, headers=None):
    headers = headers or ["JOB ID", "STATE", "AGENT", "IPV4", "TIME LEFT"]
    columns = [headers] + rows
    widths = [max(len(str(row[i])) for row in columns) for i in range(len(headers))]

    def sep():
        return "+" + "+".join("-" * (w + 2) for w in widths) + "+"

    def fmt_row(row):
        cells = [f" {str(row[i]).ljust(widths[i])} " for i in range(len(row))]
        return "|" + "|".join(cells) + "|"

    print(sep())
    print(fmt_row(headers))
    print(sep())
    for row in rows:
        print(fmt_row(row))
    print(sep())


def parse_agents(output, queue):
    agents = []
    for raw_line in output.splitlines():
        line = ANSI_RE.sub("", raw_line).strip()
        if not line or line.startswith("NAME") or line.startswith("WARNING:"):
            continue

        parts = re.split(r"\s{2,}", line, maxsplit=5)
        if len(parts) < 5:
            continue

        name, status, location, provision_type = parts[:4]
        if len(parts) == 6 and JOB_ID_RE.match(parts[4]):
            job_id = parts[4]
            queue_text = parts[5]
        else:
            job_id = "-"
            queue_text = parts[4]

        tokens = [token.strip() for token in queue_text.split(",") if token.strip()]
        model = tokens[2] if len(tokens) > 2 else "-"
        tags = [token for token in tokens[3:] if token != queue]
        agents.append(
            {
                "name": name,
                "status": status,
                "location": location,
                "provision_type": provision_type,
                "job_id": job_id,
                "model": model,
                "tags": ", ".join(tags) or "-",
            }
        )
    return agents


def cmd_machines(args):
    tfl_args = [
        "list-agents",
        "--filter-queues",
        args.queue,
        "--fields",
        "name,status,location,provision_type,job_id,queues",
    ]
    if not args.all:
        tfl_args.extend(["--filter-status", "waiting"])

    rc, out, err = run_tfl(*tfl_args)
    if rc != 0:
        print(err.strip() or "failed to list testflinger agents", file=sys.stderr)
        sys.exit(1)

    agents = parse_agents(out, args.queue)
    if not agents:
        availability = "" if args.all else " available"
        print(f"No{availability} machines found in queue '{args.queue}'.")
        return

    rows = [
        [
            agent["name"],
            agent["status"],
            agent["model"],
            agent["tags"],
            agent["location"],
            agent["provision_type"],
            agent["job_id"],
        ]
        for agent in agents
    ]
    print_table(rows, ["NAME", "STATUS", "MODEL", "TAGS", "LOCATION", "PROVISION", "JOB ID"])


def get_available_machines(queue):
    rc, out, err = run_tfl(
        "list-agents",
        "--filter-queues",
        queue,
        "--filter-status",
        "waiting",
        "--fields",
        "name,status,location,provision_type,job_id,queues",
    )
    if rc != 0:
        print(err.strip() or "failed to list testflinger agents", file=sys.stderr)
        return []
    return parse_agents(out, queue)


def get_active_reservations():
    """Return info dicts for jobs currently in the reserve state."""
    job_ids = get_job_ids()
    if not job_ids:
        return []

    # results calls are network round trips; fetch them concurrently
    with ThreadPoolExecutor(max_workers=min(len(job_ids), 16)) as pool:
        all_results = list(pool.map(get_job_results, job_ids))

    reservations = []
    for job_id, results in zip(job_ids, all_results):
        state = results.get("job_state", "unknown")
        if state not in ("reserve", "reserved"):
            continue

        device_info = results.get("device_info", {}) or {}
        agent = device_info.get("agent_name", "-")
        ipv4 = device_info.get("device_ip", "-")

        expiry = parse_expiry(results.get("reserve_output", "") or "")
        if expiry is not None:
            now = datetime.datetime.now(expiry.tzinfo)
            time_left = format_timedelta(expiry - now)
        else:
            time_left = "-"

        reservations.append(
            {
                "job_id": job_id,
                "state": state,
                "agent": agent,
                "ipv4": ipv4,
                "time_left": time_left,
            }
        )
    return reservations


def cmd_list(_args):
    reservations = get_active_reservations()
    if not reservations:
        print("No active (reserved) testflinger jobs found.")
        return

    rows = [
        [r["job_id"], r["state"], r["agent"], r["ipv4"], r["time_left"]]
        for r in reservations
    ]
    print_table(rows)


def find_reservation(target, reservations):
    """Match target against a job id or agent name (exact or prefix)."""
    matches = [
        r
        for r in reservations
        if r["job_id"] == target
        or r["agent"] == target
        or r["job_id"].startswith(target)
        or r["agent"].startswith(target)
    ]
    return matches


def cmd_ssh(args):
    reservations = get_active_reservations()
    if not reservations:
        print("No active (reserved) testflinger jobs found.", file=sys.stderr)
        sys.exit(1)

    if args.target is None:
        if len(reservations) > 1:
            print(
                "Multiple active reservations found, specify a job id or agent:",
                file=sys.stderr,
            )
            for r in reservations:
                print(f"  {r['job_id']}  {r['agent']}", file=sys.stderr)
            sys.exit(1)
        match = reservations[0]
    else:
        matches = find_reservation(args.target, reservations)
        if not matches:
            print(f"No active reservation matches '{args.target}'", file=sys.stderr)
            sys.exit(1)
        if len(matches) > 1:
            print(f"'{args.target}' is ambiguous, matches:", file=sys.stderr)
            for r in matches:
                print(f"  {r['job_id']}  {r['agent']}", file=sys.stderr)
            sys.exit(1)
        match = matches[0]

    if match["ipv4"] in ("-", "", None):
        print(f"No device IP known for job {match['job_id']}", file=sys.stderr)
        sys.exit(1)

    ssh_args = [
        "ssh",
        "-o",
        "StrictHostKeyChecking=no",
        "-o",
        "UserKnownHostsFile=/dev/null",
        f"{args.user}@{match['ipv4']}",
        *args.ssh_args,
    ]
    os.execvp("ssh", ssh_args)


def resolve_reservation(target, reservations):
    if target is None:
        if len(reservations) > 1:
            print(
                "Multiple active reservations found, specify a job id or agent:",
                file=sys.stderr,
            )
            for r in reservations:
                print(f"  {r['job_id']}  {r['agent']}", file=sys.stderr)
            sys.exit(1)
        return reservations[0]

    matches = find_reservation(target, reservations)
    if not matches:
        print(f"No active reservation matches '{target}'", file=sys.stderr)
        sys.exit(1)
    if len(matches) > 1:
        print(f"'{target}' is ambiguous, matches:", file=sys.stderr)
        for r in matches:
            print(f"  {r['job_id']}  {r['agent']}", file=sys.stderr)
        sys.exit(1)
    return matches[0]


def cmd_release(args):
    reservations = get_active_reservations()
    if not reservations:
        print("No active (reserved) testflinger jobs found.", file=sys.stderr)
        sys.exit(1)

    match = resolve_reservation(args.target, reservations)
    print(f"Release {match['agent']} ({match['job_id']}) with {match['time_left']} left.")
    if not args.yes and not prompt_yes_no("Release reservation", False):
        print("Cancelled.")
        return

    rc, out, err = run_tfl("cancel", match["job_id"])
    if rc != 0:
        print(err.strip() or out.strip() or "failed to release reservation", file=sys.stderr)
        sys.exit(1)
    print(out.strip() or f"Released {match['agent']} ({match['job_id']}).")


def cmd_add_token(args):
    """Store a personal testflinger client-id/secret-key via testflinger-cli login."""
    client_id = args.client_id or input("Testflinger client id: ").strip()
    secret_key = args.secret_key or getpass.getpass("Testflinger secret key: ")

    if not client_id or not secret_key:
        print("Both a client id and secret key are required.", file=sys.stderr)
        sys.exit(1)

    rc, out, err = run_tfl("login", "--client-id", client_id, "--secret-key", secret_key)
    if rc != 0:
        print(err.strip() or out.strip() or "failed to log in", file=sys.stderr)
        sys.exit(1)

    store_credentials(client_id, secret_key)
    print(f"Token stored for client id '{client_id}'.")


def cmd_token_status(_args):
    credentials = load_credentials()
    if not AUTH_FILE.exists() and not credentials:
        print("No token stored yet. Run: tflui add-token")
        return

    if AUTH_FILE.exists():
        config = configparser.ConfigParser()
        config.read(AUTH_FILE)
        client_id = config.get("AUTH", "client_id", fallback="unknown")
        print(f"Token stored for client id '{client_id}' ({AUTH_FILE}).")
    if credentials:
        print(
            f"Credentials saved for client id '{credentials[0]}' "
            f"({CREDENTIALS_FILE})."
        )


def prompt_value(label, default=None):
    suffix = f" [{default}]" if default not in (None, "") else ""
    value = input(f"{label}{suffix}: ").strip()
    return value if value else default


def prompt_yes_no(label, default=True):
    suffix = "Y/n" if default else "y/N"
    value = input(f"{label} [{suffix}]: ").strip().lower()
    if not value:
        return default
    return value in ("y", "yes")


def choose_machine(queue):
    machines = get_available_machines(queue)
    if machines:
        print("Available machines:")
        for index, machine in enumerate(machines, start=1):
            tags = "" if machine["tags"] == "-" else f" ({machine['tags']})"
            print(f"  {index}. {machine['name']} - {machine['model']}{tags}")
    else:
        print(f"No available machines found in queue '{queue}'; random is still allowed.")

    choice = prompt_value("Machine name or number", "random")
    if choice in (None, "", "random"):
        return None
    if choice.isdigit() and machines:
        index = int(choice)
        if 1 <= index <= len(machines):
            return machines[index - 1]["name"]
    return choice


def interactive_launch(args):
    print("Configure a Testflinger reservation. Press Enter to accept defaults.")
    args.queue = prompt_value("Queue", args.queue)
    args.machine = choose_machine(args.queue)
    args.distro = prompt_value("Distro", args.distro)
    args.lease = prompt_value("Lease time (examples: 2h, 1d, 14d)", DEFAULT_LEASE)
    args.key = []
    key_default = DEFAULT_KEY or "lp:<your-launchpad-id>"
    key = prompt_value("SSH key to inject", key_default)
    if key:
        args.key.append(key)
    args.ephemeral = prompt_yes_no("Use MAAS ephemeral deployment", args.ephemeral)

    queue = args.machine or args.queue
    timeout = parse_duration(args.lease)
    print()
    print(f"Queue:      {queue}{' (specific machine)' if args.machine else ''}")
    print(f"Distro:     {args.distro}")
    print(f"Lease time: {format_duration(timeout)}")
    print(f"SSH keys:   {', '.join(args.key)}")
    if args.ephemeral:
        print("Ephemeral:  yes")
    print()
    if not prompt_yes_no("Submit reservation", True):
        print("Cancelled.")
        sys.exit(0)


def cmd_launch(args):
    if args.interactive:
        interactive_launch(args)

    keys = args.key or ([DEFAULT_KEY] if DEFAULT_KEY else [])
    if not keys:
        key = input("SSH key to inject (example: lp:your-launchpad-id or gh:your-github-id): ").strip()
        if key:
            keys.append(key)

    if not keys:
        print("At least one SSH key is required to launch a usable reservation.", file=sys.stderr)
        sys.exit(1)

    try:
        timeout = parse_duration(args.lease) if args.lease else args.timeout
    except ValueError:
        print(f"Invalid lease time '{args.lease}'. Use values like 3600, 2h, 1d, or 1w.", file=sys.stderr)
        sys.exit(1)

    queue = args.machine if args.machine and args.machine != "random" else args.queue

    reserve_args = [
        TFL,
        "reserve",
        "--queue",
        queue,
        "--distro",
        args.distro,
        "--timeout",
        str(timeout),
        "--yes",
    ]
    if args.ephemeral:
        reserve_args.append("--ephemeral")
    if args.dry_run:
        reserve_args.append("--dry-run")
    for key in keys:
        reserve_args.extend(["--key", key])

    sys.exit(subprocess.run(reserve_args, check=False).returncode)


def main():
    parser = argparse.ArgumentParser(
        prog="tflui", description="A friendlier wrapper around testflinger-cli"
    )
    subparsers = parser.add_subparsers(dest="command")
    subparsers.add_parser("list", help="List active testflinger reservations")

    machines_parser = subparsers.add_parser(
        "machines", help="List machines in a testflinger queue"
    )
    machines_parser.add_argument("-q", "--queue", default=DEFAULT_QUEUE, help=f"Queue name (default: {DEFAULT_QUEUE})")
    machines_parser.add_argument("--all", action="store_true", help="Include busy and unavailable machines")

    launch_parser = subparsers.add_parser(
        "launch", help="Quick launch a reserved testflinger instance"
    )
    launch_parser.add_argument("-q", "--queue", default=DEFAULT_QUEUE, help=f"Queue name (default: {DEFAULT_QUEUE})")
    launch_parser.add_argument("-m", "--machine", help="Specific machine to reserve, or 'random' (default)")
    launch_parser.add_argument("--distro", default=DEFAULT_DISTRO, help=f"Distro to provision (default: {DEFAULT_DISTRO})")
    launch_parser.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT, help=f"Reservation timeout in seconds (default: {DEFAULT_TIMEOUT})")
    launch_parser.add_argument("--lease", help="Human-friendly lease time, e.g. 2h, 1d, 14d")
    launch_parser.add_argument("-k", "--key", action="append", help="SSH key to inject, e.g. lp:userid or gh:userid")
    launch_parser.add_argument("--ephemeral", action="store_true", help="Use a MAAS ephemeral deployment")
    launch_parser.add_argument("--dry-run", action="store_true", help="Print the job data without submitting")
    launch_parser.add_argument("--no-interactive", action="store_true", help="Use defaults/flags without prompts")

    ssh_parser = subparsers.add_parser(
        "ssh", help="SSH into a reserved testflinger device"
    )
    ssh_parser.add_argument(
        "target",
        nargs="?",
        help="Job id (or prefix) or agent name to ssh into; "
        "omit if you only have one active reservation",
    )
    ssh_parser.add_argument("-u", "--user", default="ubuntu", help="SSH user (default: ubuntu)")
    ssh_parser.add_argument(
        "ssh_args", nargs=argparse.REMAINDER, help="Extra arguments passed to ssh"
    )

    release_parser = subparsers.add_parser(
        "release", help="Release a reserved testflinger device early"
    )
    release_parser.add_argument(
        "target",
        nargs="?",
        help="Job id (or prefix) or agent name to release; "
        "omit if you only have one active reservation",
    )
    release_parser.add_argument("-y", "--yes", action="store_true", help="Skip confirmation prompt")

    add_token_parser = subparsers.add_parser(
        "add-token",
        help="Store your personal testflinger client-id/secret-key",
    )
    add_token_parser.add_argument("--client-id", help="Testflinger client id")
    add_token_parser.add_argument("--secret-key", help="Testflinger secret key")

    subparsers.add_parser("token-status", help="Show which client id has a token stored")

    args = parser.parse_args()
    if args.command == "launch":
        args.interactive = len(sys.argv) == 2 and sys.stdin.isatty() and not args.no_interactive

    if args.command == "machines":
        cmd_machines(args)
    elif args.command == "launch":
        cmd_launch(args)
    elif args.command == "ssh":
        cmd_ssh(args)
    elif args.command == "release":
        cmd_release(args)
    elif args.command == "add-token":
        cmd_add_token(args)
    elif args.command == "token-status":
        cmd_token_status(args)
    elif args.command in (None, "list"):
        cmd_list(args)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
